<%# Langkah penyiapan yang masih perlu dikerjakan — lihat SetupChecklist. Hilang
    sendiri begitu langkah wajibnya beres. %>
<section class="bg-white rounded-2xl ring-1 ring-indigo-200 overflow-hidden" data-testid="setup-checklist">
  <div class="px-5 py-4 bg-indigo-50 border-b border-indigo-100 flex items-center justify-between flex-wrap gap-2">
    <div>
      <h2 class="text-sm font-bold text-indigo-950">Langkah Penyiapan</h2>
      <p class="text-xs text-indigo-800 mt-0.5"><%= @setup_checklist.done_count %> dari <%= @setup_checklist.steps.size %> selesai. Kerjakan berurutan dari atas.</p>
    </div>
    <%= link_to "Buka Panduan Penyiapan →", panduan_path(anchor: "panduan-penyiapan-untuk-kaprodi--admin-prodi"),
          class: "text-xs font-semibold text-indigo-700 hover:text-indigo-900" %>
  </div>
  <ul class="divide-y divide-gray-100">
    <% @setup_checklist.steps.each do |step| %>
      <li class="px-5 py-3 flex items-start gap-3" data-setup-step="<%= step.done ? "done" : "todo" %>">
        <span class="mt-0.5 h-5 w-5 shrink-0 rounded-full flex items-center justify-center text-[11px] font-bold <%= step.done ? "bg-emerald-500 text-white" : "ring-1 ring-inset ring-gray-300 text-gray-400" %>" aria-hidden="true"><%= step.done ? "✓" : "" %></span>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold <%= step.done ? "text-gray-500" : "text-gray-900" %>">
            <%= step.label %>
            <% if step.optional %><span class="ml-1 text-[10px] font-bold uppercase tracking-wide text-gray-400">Dianjurkan</span><% end %>
          </p>
          <% unless step.done %><p class="text-xs text-gray-500 mt-0.5"><%= step.detail %></p><% end %>
        </div>
        <% if step.path && !step.done %>
          <%= link_to "Kerjakan →", step.path, class: "shrink-0 text-xs font-semibold text-indigo-600 hover:text-indigo-800" %>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
